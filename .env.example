# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database
DB_URI=mongodb://localhost:27017/sky-key-ai
DB_NAME=sky-key-ai

# API Keys
OPENAI_API_KEY=your_openai_api_key
GOOGLE_CLOUD_API_KEY=your_google_cloud_key
SPEECH_API_KEY=your_speech_api_key

# Voice Configuration
VOICE_LANGUAGE=en-US
SUPPORTED_LANGUAGES=en,hi,es,fr,de,ja,zh

# Gesture Configuration
GESTURE_SENSITIVITY=0.7
MIN_CONFIDENCE=0.5
GESTURE_TIMEOUT=2000

# App Control
APP_WHITELIST=camera,gallery,contacts,settings
ENABLE_SYSTEM_CONTROL=true

# Body Scanner
ENABLE_BODY_SCANNER=true
BODY_SCANNER_PORT=5000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Feature Flags
FEATURE_OFFLINE_MODE=false
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_CLOUD_SYNC=true

# AI Model
AI_MODEL_PATH=./models/
USE_GPU=true

# Security
JWT_SECRET=your_jwt_secret_key
SESSION_TIMEOUT=3600

# Development
DEBUG=false
MOCK_GESTURES=false
MOCK_VOICE=false
